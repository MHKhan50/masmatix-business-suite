{
  "system": "imei",
  "title": "Mobile IMEI tracker",
  "entities": [
    {
      "name": "WarrantyClaim",
      "label": "Warranty claims",
      "path": "claims",
      "fields": [
        {
          "name": "imei",
          "type": "string",
          "required": true,
          "max": 15
        },
        {
          "name": "fault",
          "type": "text",
          "required": true
        },
        {
          "name": "receivedOn",
          "type": "date",
          "required": true
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "RECEIVED",
            "SENT_TO_SERVICE",
            "REPAIRED",
            "RETURNED",
            "REJECTED"
          ]
        }
      ],
      "samples": [
        {
          "imei": "000000000000018",
          "fault": "Charging port loose (sample)",
          "receivedOn": "2026-10-18",
          "status": "SENT_TO_SERVICE"
        }
      ]
    }
  ]
}
